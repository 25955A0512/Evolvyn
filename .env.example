# Development only. Do not commit real values.
DATABASE_URL=postgresql://evolvyn@127.0.0.1:5432/evolvyn
EVOLVYN_ACCESS_TOKEN=replace-with-a-random-workspace-secret
# Optional: enables live AI interpretation, sends uploaded evidence to OpenAI
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini

# Optional OAuth. Compose reads these from ignored .local/deploy.env.
# Register callbacks under PUBLIC_ORIGIN/api/auth/oauth/{google|github}/callback.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
